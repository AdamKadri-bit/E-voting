APP_NAME="E-Voting"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend origin (used for CORS + links). Must match where Vite serves the app.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Default: zero-config SQLite. Just create the file:
#   touch database/database.sqlite
DB_CONNECTION=sqlite

# --- MySQL (recommended for production / the setup this project targets) ---
# Comment out the line above and use this block instead:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=evoting
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail -----------------------------------------------------------------
# Email verification is required before login. With the "log" mailer, the
# verification link is written to storage/logs/laravel.log (handy for local dev).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@evoting.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Auth (JWT in HttpOnly cookie) ----------------------------------------
# Generate a strong secret, e.g. on macOS/Linux:
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL_MINUTES=15

# --- Google Cloud Vision (Lebanese ID OCR) --------------------------------
# Only needed for the ID-scan feature. Place the service-account JSON at
# backend/google-credentials.json (git-ignored).

# Frontend (frontend/.env VITE_API_URL) expects the API on 8001.
# Set here so plain `php artisan serve` binds the right port.
SERVER_PORT=8001
